// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"

  model User {
  id       Int    @id @default(autoincrement())
  name     String
  email    String @unique
  password String
}

model Restaurant {
  id       Int    @id @default(autoincrement())
  name     String
  location String
}

model MenuItem {
  id           Int    @id @default(autoincrement())
  name         String
  price        Float
  stock        Int
  restaurantId Int
}

model Order {
  id          Int    @id @default(autoincrement())
  userId      Int
  status      String
  totalAmount Float
}
}
